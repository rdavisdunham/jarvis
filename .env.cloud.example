# Local handoff file. Not loaded by the local app; never commit or paste into chat.
# Run scripts/prepare_cloud.py to copy existing credentials without displaying them.
# Use separate Railway service variables as documented in docs/CLOUD_MIGRATION.md.
JARVIS_DEPLOYMENT_ENVIRONMENT=staging
JARVIS_ORIGIN=
JARVIS_DATABASE_URL=
JARVIS_PAIRING_ENABLED=false
JARVIS_WORKER_ENABLED=false
JARVIS_EXTERNAL_SERVICES_ENABLED=false
# Enable on API and worker after deployment and search backfill verification.
JARVIS_SEMANTIC_SEARCH_ENABLED=false
JARVIS_MAINTENANCE_MODE=false
JARVIS_DATABASE_POOL_SIZE=5
JARVIS_DATABASE_MAX_OVERFLOW=2
JARVIS_DBOS_POOL_SIZE=10
JARVIS_DBOS_CLIENT_POOL_SIZE=5
JARVIS_OWNER_ID=davin
JARVIS_OWNER_NAME=Davis
JARVIS_TIMEZONE=America/Chicago
JARVIS_COST_TRACKING_ENABLED=false
JARVIS_GOOGLE_CLIENT_ID=
JARVIS_GOOGLE_CLIENT_SECRET=
JARVIS_INTEGRATION_ENCRYPTION_KEY=
JARVIS_OPENAI_API_KEY=
JARVIS_GEMINI_API_KEY=
JARVIS_VAPID_PRIVATE_KEY=
JARVIS_VAPID_PUBLIC_KEY=
JARVIS_VAPID_SUBJECT=
JARVIS_BACKUP_KEY=
JARVIS_BACKUP_REQUIRE_REMOTE=true
JARVIS_BACKUP_S3_ENDPOINT=
JARVIS_BACKUP_S3_BUCKET=eridani-backups
JARVIS_BACKUP_S3_ACCESS_KEY_ID=
JARVIS_BACKUP_S3_SECRET_ACCESS_KEY=
JARVIS_BACKUP_S3_REGION=auto
JARVIS_BACKUP_S3_PREFIX=eridani/staging
JARVIS_BACKUP_DIRECTORY=/backups
WEB_CONCURRENCY=1
# Trust the Railway ingress only when API traffic enters through its HTTP proxy.
FORWARDED_ALLOW_IPS=*

# Record usage without pausing Eri at a monthly budget during development.
JARVIS_COST_TRACKING_ENABLED=true
JARVIS_BUDGET_ENFORCEMENT_ENABLED=false
# Set to a UTC ISO timestamp when tracking resumes after a gap.
# JARVIS_COST_TRACKING_SINCE=2026-09-19T00:00:00Z
