# Backend
GROQ_API_KEY=your_groq_api_key_here
# Hugging Face token (required for Kokoro model download)
HF_TOKEN=your_hf_token_here

# Speech-to-Text provider: "groq" (Groq Whisper API) or "local" (streaming faster-whisper on GPU)
STT_PROVIDER=groq
# faster-whisper model size (only when STT_PROVIDER=local): tiny.en, base.en, small.en, medium.en, large-v3
WHISPER_MODEL=medium.en

# Legacy setting (deprecated, use STT_PROVIDER instead)
# USE_LOCAL_WHISPER=false

# System prompt that defines JARVIS's personality
JARVIS_SYSTEM_PROMPT="You are my good friend and AI companion who loves to roast me. You also love salamanders. **Vocal Cues:** Control delivery with bracketed 1-2 word adjectives/adverbs to signal social awkwardness or enthusiasm shifts. Do this kind of sparingly, 2-3 times a response. Suggestions (though you can use other simple descriptors not in this list): [cheerful], [friendly], [casual], [warm], [professionally], [authoritatively], [formally], [confidently], [excited], [dramatic], [deadpan], [sarcastic], [gravelly whisper], [rapid babbling], [singsong], [breathy], [cheerful singsong], [dropping tone], [piercing shout], [exasperated sigh], [mock sympathy], [building intensity], [crescendo], [slurring slightly], [giggling], [fast paced], [cough], [laugh], [chuckle]. **LENGTH** Keep general responses to 1-3 sentences unless it's an explanation or response that needs the extra context to be accurate."

# Text-to-Speech provider: "groq" (Orpheus cloud API) or "kokoro" (local Kokoro-82M on GPU)
TTS_PROVIDER=groq

# Groq Orpheus settings (used when TTS_PROVIDER=groq)
# Orpheus voice options: autumn, tara, leah, jess, leo, dan, mia, zac
TTS_ORPHEUS_VOICE=daniel
# Orpheus speech speed: 1.0 = normal, 1.5 = faster, 2.0 = very fast (range: 0.25-4.0)
TTS_ORPHEUS_SPEED=2.0

# Kokoro settings (used when TTS_PROVIDER=kokoro)
# Voice preset (default: af_heart). See https://huggingface.co/hexgrad/Kokoro-82M for full list
TTS_KOKORO_VOICE=af_heart
# Speech speed: 1.0 = normal (range: 0.5-2.0)
TTS_KOKORO_SPEED=1.0
# Language code: "a" = American English, "b" = British English
TTS_KOKORO_LANG=a

# Long-term memory (Mem0 + Qdrant)
# Set to "false" to disable memory entirely
MEMORY_ENABLED=true
# Embedding device: "cuda" (faster, uses ~100MB VRAM) or "cpu"
MEMORY_DEVICE=cuda
# Minimum relevance score for memory search results (0.0 - 1.0)
MEMORY_SEARCH_THRESHOLD=0.5
# Max memories returned per category (user facts / JARVIS facts)
MEMORY_SEARCH_LIMIT_USER=10
MEMORY_SEARCH_LIMIT_JARVIS=10
# LLM model used for memory extraction (needs to follow extraction prompts reliably)
MEMORY_LLM_MODEL=llama-3.3-70b-versatile

# End-of-Utterance detection (LiveKit turn detector model, local STT only)
# Detects whether the user is done speaking based on transcript content
# Requires HF_TOKEN for model download (~400MB, runs on CPU ~25ms)
EOU_ENABLED=false
# Confidence threshold — 0.011 is the LiveKit-calibrated threshold for English
EOU_THRESHOLD=0.011
# Seconds to wait after VAD silence before force-finalizing (if EOU says not done)
EOU_TIMEOUT=3.0
