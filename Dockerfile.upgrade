# Production image for the Eridani API and worker (Railway: Eridani_Web / Eridani_Worker).
# Railway overrides CMD with explicit start commands in .railway/railway.ts
# (`python -m jarvis.deploy api|worker`, preDeploy `python -m jarvis.deploy migrate`).
# The default CMD below uses the same validated entry point so a bare `docker run`
# cannot skip deploy.py's configuration checks.
#
# TODO(supply-chain): base images are pinned by tag, not digest. Resolve and pin
# `image:tag@sha256:...` for node, python and uv (requires registry access), then add a
# Dependabot docker entry so the digests stay current.

FROM node:22-bookworm-slim AS web
WORKDIR /build
COPY apps/web/package.json apps/web/package-lock.json ./
RUN npm ci --no-audit --no-fund
COPY apps/web/ ./
RUN npm run build

FROM python:3.12-slim-bookworm AS core
COPY --from=ghcr.io/astral-sh/uv:0.11.16 /uv /uvx /bin/
WORKDIR /app
ENV PYTHONUNBUFFERED=1 UV_COMPILE_BYTECODE=1 UV_LINK_MODE=copy
# Locked third-party dependencies first: this layer is reused until uv.lock/pyproject change.
COPY pyproject.toml uv.lock ./
RUN uv sync --frozen --no-dev --no-install-project
# Application source, then install the project itself into the existing environment.
COPY apps/api ./apps/api
RUN uv sync --frozen --no-dev
COPY migrations ./migrations
COPY alembic.ini ./
COPY --from=web /build/dist ./apps/web/dist
RUN useradd --uid 10001 --create-home jarvis && chown -R jarvis:jarvis /app
USER jarvis
EXPOSE 8765
# Honors PORT (default 8765), single Uvicorn worker, proxy headers; validates cloud config
# when JARVIS_DEPLOYMENT_ENVIRONMENT is not "local" or when running on Railway.
CMD ["/app/.venv/bin/python", "-m", "jarvis.deploy", "api"]
