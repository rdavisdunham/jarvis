# Allow only the build inputs; exclude secrets even inside allowed source directories.
**
!Dockerfile.upgrade
!pyproject.toml
!uv.lock
!alembic.ini
!apps
!apps/api
!apps/api/**
!apps/web
!apps/web/**
!migrations
!migrations/**
**/node_modules
**/dist
**/__pycache__
**/*.pyc
**/.env*
**/*.pem
**/*.key
**/*.pgdump*
**/*.sqlite*
**/test-results
**/playwright-report
