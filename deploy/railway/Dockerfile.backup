FROM postgres:16.15-bookworm
RUN apt-get update \
    && apt-get install -y --no-install-recommends python3 python3-cryptography python3-boto3 \
    && rm -rf /var/lib/apt/lists/* \
    && useradd --uid 10001 --create-home eridani_backup \
    && mkdir -p /backups && chown eridani_backup:eridani_backup /backups
COPY scripts/backup.py /usr/local/bin/jarvis-backup.py
USER eridani_backup
ENTRYPOINT []
CMD ["python3", "/usr/local/bin/jarvis-backup.py", "once"]
