{
  "version": 1,
  "job": "routing_review",
  "description": "The weekly organization review: from human-filed examples, propose title phrases that reliably identify an existing home. Graded like routing.process filters candidates: the home must exist, the phrase must match at least one example of that type (routing.matches) and every matching example must agree (routing.agrees). `definition: default` is structure.default_definition().",
  "prompt_source": "jarvis.routing.infer_request(Candidates, REVIEW_PROMPT, payload)",
  "grader": "structured",
  "cases": [
    {
      "id": "client-names",
      "tags": ["client"],
      "input": {"payload": {
        "definition": "default",
        "examples": [
          {"id": "t01", "title": "Acme: send October invoice", "type_id": "task", "assignment": {"parent_id": "rec_acme", "values": {}}},
          {"id": "t02", "title": "Review Acme onboarding deck", "type_id": "task", "assignment": {"parent_id": "rec_acme", "values": {}}},
          {"id": "t03", "title": "Call Acme about renewal", "type_id": "task", "assignment": {"parent_id": "rec_acme", "values": {}}},
          {"id": "t04", "title": "Acme quarterly business review prep", "type_id": "task", "assignment": {"parent_id": "rec_acme", "values": {}}},
          {"id": "t05", "title": "Globex data audit kickoff", "type_id": "task", "assignment": {"parent_id": "rec_globex", "values": {}}},
          {"id": "t06", "title": "Email Globex the SOW draft", "type_id": "task", "assignment": {"parent_id": "rec_globex", "values": {}}},
          {"id": "t07", "title": "Globex warehouse access request", "type_id": "task", "assignment": {"parent_id": "rec_globex", "values": {}}},
          {"id": "t08", "title": "Call the dentist", "type_id": "task", "assignment": {"parent_id": "rec_personal", "values": {}}},
          {"id": "t09", "title": "Email landlord about the lease", "type_id": "task", "assignment": {"parent_id": "rec_personal", "values": {}}}
        ],
        "note_lists": [],
        "homes": [
          {"id": "rec_acme", "title": "Acme Corp", "type_id": "client"},
          {"id": "rec_globex", "title": "Globex", "type_id": "client"},
          {"id": "rec_personal", "title": "Personal", "type_id": "space"}
        ]
      }},
      "expect": {
        "must_find": [
          {"type_id": "task", "parent_id": "rec_acme", "phrase_any": ["acme"]},
          {"type_id": "task", "parent_id": "rec_globex", "phrase_any": ["globex"]}
        ],
        "max_invalid": 0,
        "forbid_phrases": ["call", "email", "review", "send"]
      },
      "stub": {"candidates": [
        {"phrase": "Acme", "type_id": "task", "parent_id": "rec_acme", "values": [], "note_tags": [], "reason": "Every task naming Acme was filed under Acme Corp."},
        {"phrase": "Globex", "type_id": "task", "parent_id": "rec_globex", "values": [], "note_tags": [], "reason": "Every task naming Globex was filed under Globex."}
      ]},
      "stub_wrong": {"candidates": [
        {"phrase": "Acme", "type_id": "task", "parent_id": "rec_acme", "values": [], "note_tags": [], "reason": "Acme tasks."},
        {"phrase": "call", "type_id": "task", "parent_id": "rec_personal", "values": [], "note_tags": [], "reason": "Calls are personal."}
      ]}
    },
    {
      "id": "project-beats-client",
      "tags": ["project", "precision"],
      "input": {"payload": {
        "definition": "default",
        "examples": [
          {"id": "t11", "title": "Acme churn dashboard: monthly query", "type_id": "task", "assignment": {"parent_id": "rec_churn", "values": {}}},
          {"id": "t12", "title": "Acme churn dashboard: cohort chart", "type_id": "task", "assignment": {"parent_id": "rec_churn", "values": {}}},
