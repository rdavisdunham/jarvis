   "kind": "transcript",
   "owner_id": "fixture-owner",
   "revision_id": "64c12223-4de9-5e03-802b-2ae6709ede33",
   "seq": 3,
   "speaker_actor_id": null,
   "speaker_attribution": null,
   "speaker_label": "Speaker 1",
   "speaker_link_status": "unresolved",
   "speaker_provenance": {},
   "start_ms": 16500,
   "text": "The payment SDK update could break checkout on older Android phones."
  },
  {
   "char_end": 39,
   "char_start": 0,
   "created_at": "2026-10-07T08:00:00+00:00",
   "end_ms": 4000,
   "id": "4addd481-9512-586a-91de-abe39be54c94",
   "kind": "transcript",
   "owner_id": "fixture-owner",
   "revision_id": "b336e7f5-9c58-5365-877b-b57bdd610b45",
   "seq": 0,
   "speaker_actor_id": null,
   "speaker_attribution": null,
   "speaker_label": "Speaker 1",
   "speaker_link_status": "unresolved",
   "speaker_provenance": {},
   "start_ms": 0,
   "text": "The Android checkout bug is still open."
  },
  {
   "char_end": 98,
   "char_start": 40,
   "created_at": "2026-10-07T08:00:00+00:00",
   "end_ms": 9500,
   "id": "26208ac1-55c5-5fe4-8449-de9aa7b7d254",
   "kind": "transcript",
   "owner_id": "fixture-owner",
   "revision_id": "b336e7f5-9c58-5365-877b-b57bdd610b45",
   "seq": 1,
   "speaker_actor_id": null,
   "speaker_attribution": null,
   "speaker_label": "Speaker 2",
   "speaker_link_status": "unresolved",
   "speaker_provenance": {},
   "start_ms": 5500,
   "text": "I'll pair with Jonas on the Android checkout bug tomorrow."
  },
  {
   "char_end": 153,
   "char_start": 99,
   "created_at": "2026-10-07T08:00:00+00:00",
   "end_ms": 15000,
   "id": "2474eba9-8b58-52d9-a4d2-e3b19a03545a",
   "kind": "transcript",
   "owner_id": "fixture-owner",
   "revision_id": "b336e7f5-9c58-5365-877b-b57bdd610b45",
   "seq": 2,
   "speaker_actor_id": null,
   "speaker_attribution": null,
   "speaker_label": "Speaker 3",
   "speaker_link_status": "unresolved",
   "speaker_provenance": {},
   "start_ms": 11000,
   "text": "Do we need a feature flag for the new onboarding flow?"
  },
  {
   "char_end": 211,
   "char_start": 154,
   "created_at": "2026-10-07T08:00:00+00:00",
   "end_ms": 20500,
   "id": "e9008a62-e62f-5317-a53f-10d601392b15",
   "kind": "transcript",
   "owner_id": "fixture-owner",
   "revision_id": "b336e7f5-9c58-5365-877b-b57bdd610b45",
   "seq": 3,
   "speaker_actor_id": null,
   "speaker_attribution": null,
   "speaker_label": "Speaker 3",
   "speaker_link_status": "unresolved",
   "speaker_provenance": {},
   "start_ms": 16500,
   "text": "I'll rewrite the onboarding copy if the experiment loses."
  },
  {
   "char_end": 105,
   "char_start": 0,
   "created_at": "2026-10-13T10:00:00+00:00",
   "end_ms": 8000,
   "id": "c08e5c67-8687-582b-8137-cfdbdc4ab3e2",
   "kind": "transcript",
   "owner_id": "fixture-owner",
   "revision_id": "d37f7bc7-4c78-5425-9831-5829fa8eaaa1",
   "seq": 0,
   "speaker_actor_id": null,
   "speaker_attribution": "other",
   "speaker_label": "Jonas Weber",
   "speaker_link_status": "unresolved",
   "speaker_provenance": {},
   "start_ms": 0,
   "text": "The regression plan for checkout went out on the 17th, and the full regression suite passed this morning."
  },
  {
   "char_end": 145,
   "char_start": 106,
   "created_at": "2026-10-13T10:00:00+00:00",
   "end_ms": 13500,
   "id": "7d4319e7-1e63-5d55-83eb-3813063086ee",
   "kind": "transcript",
   "owner_id": "fixture-owner",
   "revision_id": "d37f7bc7-4c78-5425-9831-5829fa8eaaa1",
   "seq": 1,
   "speaker_actor_id": null,
   "speaker_attribution": "other",
   "speaker_label": "Sam Patel",
   "speaker_link_status": "unresolved",
   "speaker_provenance": {},
   "start_ms": 9500,
   "text": "I sent the cohort analysis on the 24th."
  },
  {
   "char_end": 211,
   "char_start": 146,
   "created_at": "2026-10-13T10:00:00+00:00",
   "end_ms": 20000,
   "id": "10a571e5-a9a3-5822-8106-3a5f562539e8",
   "kind": "transcript",
   "owner_id": "fixture-owner",
   "revision_id": "d37f7bc7-4c78-5425-9831-5829fa8eaaa1",
   "seq": 2,
   "speaker_actor_id": null,
   "speaker_attribution": "owner",
   "speaker_label": "Robin Hale",
   "speaker_link_status": "unresolved",
   "speaker_provenance": {},
   "start_ms": 15000,
   "text": "Decision: we keep the analytics SDK and ship the tracking prompt."
  },
  {
   "char_end": 274,
   "char_start": 212,
   "created_at": "2026-10-13T10:00:00+00:00",
   "end_ms": 26500,
   "id": "070a230a-4223-523b-bd15-a8a861ea3322",
   "kind": "transcript",
   "owner_id": "fixture-owner",
   "revision_id": "d37f7bc7-4c78-5425-9831-5829fa8eaaa1",
   "seq": 3,
   "speaker_actor_id": null,
   "speaker_attribution": "owner",
   "speaker_label": "Robin Hale",
   "speaker_link_status": "unresolved",
   "speaker_provenance": {},
   "start_ms": 21500,
   "text": "I will send the release announcement to support on 2026-10-20."
  },
  {
   "char_end": 59,
   "char_start": 0,
   "created_at": "2026-09-22T10:00:00+00:00",
   "end_ms": 4000,
   "id": "bd39d7bb-7a63-54c5-bbbf-42cd264d32b2",
   "kind": "transcript",
   "owner_id": "fixture-owner",
   "revision_id": "efeed64e-606b-549f-936b-6125694b4dca",
   "seq": 0,
   "speaker_actor_id": null,
   "speaker_attribution": "other",
   "speaker_label": "Jonas Weber",
   "speaker_link_status": "unresolved",
   "speaker_provenance": {},
   "start_ms": 0,
   "text": "The payment SDK fix landed but it needs another week of QA."
  },
  {
   "char_end": 161,
   "char_start": 60,
   "created_at": "2026-09-22T10:00:00+00:00",
   "end_ms": 13500,
   "id": "6ba7dbd8-009a-5fb3-a523-783c4bc68912",
   "kind": "transcript",
   "owner_id": "fixture-owner",
   "revision_id": "efeed64e-606b-549f-936b-6125694b4dca",
   "seq": 1,
   "speaker_actor_id": null,
   "speaker_attribution": "other",
   "speaker_label": "Sam Patel",
   "speaker_link_status": "unresolved",
   "speaker_provenance": {},
   "start_ms": 5500,
   "text": "Decision: we move the 4.0 release to 2026-10-21 because the payment SDK fix needs another week of QA."
  },
  {
   "char_end": 225,
   "char_start": 162,
   "created_at": "2026-09-22T10:00:00+00:00",
   "end_ms": 20000,
   "id": "0c058de2-5ff0-5966-889e-81e7ab1fa26f",
   "kind": "transcript",
   "owner_id": "fixture-owner",
   "revision_id": "efeed64e-606b-549f-936b-6125694b4dca",
   "seq": 2,
   "speaker_actor_id": null,
   "speaker_attribution": "other",
   "speaker_label": "Jonas Weber",
   "speaker_link_status": "unresolved",
   "speaker_provenance": {},
   "start_ms": 15000,
   "text": "Action: Jonas to rerun the full regression suite by 2026-10-16."
  },
  {
   "char_end": 77,
   "char_start": 0,
   "created_at": "2026-10-27T11:00:00+00:00",
   "end_ms": 6000,
   "id": "a7b8d478-977d-5e69-bfa5-89445eb2505f",
   "kind": "transcript",
   "owner_id": "fixture-owner",
   "revision_id": "f2b62552-21af-5d6a-ae76-7149dabc5621",
   "seq": 0,
   "speaker_actor_id": null,
   "speaker_attribution": "other",
   "speaker_label": "Sam Patel",
   "speaker_link_status": "unresolved",
   "speaker_provenance": {},
   "start_ms": 0,
   "text": "The 4.0 release went out on 2026-10-21 with 99.3 percent crash-free sessions."
  },
  {
   "char_end": 134,
   "char_start": 78,
   "created_at": "2026-10-27T11:00:00+00:00",
   "end_ms": 11500,
   "id": "85c27e67-4179-5103-a6be-0cf8dafef6ac",
   "kind": "transcript",
   "owner_id": "fixture-owner",
   "revision_id": "f2b62552-21af-5d6a-ae76-7149dabc5621",
   "seq": 1,
   "speaker_actor_id": null,
   "speaker_attribution": "owner",
   "speaker_label": "Robin Hale",
   "speaker_link_status": "unresolved",
   "speaker_provenance": {},
   "start_ms": 7500,
   "text": "I sent the release announcement to support last Tuesday."
  },
  {
   "char_end": 191,
   "char_start": 135,
   "created_at": "2026-10-27T11:00:00+00:00",
   "end_ms": 17000,
   "id": "0d7f08d3-624a-5a7c-9b0c-7168641e144e",
   "kind": "transcript",
   "owner_id": "fixture-owner",
   "revision_id": "f2b62552-21af-5d6a-ae76-7149dabc5621",
   "seq": 2,
   "speaker_actor_id": null,
   "speaker_attribution": "other",
   "speaker_label": "Mei Lin",
   "speaker_link_status": "unresolved",
   "speaker_provenance": {},
   "start_ms": 13000,
   "text": "I will not take on the tablet layout until the new year."
  }
