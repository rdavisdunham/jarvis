 "chunks": [
  {
   "created_at": "2026-09-15T14:00:00+00:00",
   "id": "01a66850-9208-573a-8be7-169420817046",
   "owner_id": "fixture-owner",
   "revision_id": "431c1fd9-1973-567b-a1d2-c11c83246da3",
   "segment_end": 3,
   "segment_start": 0,
   "seq": 0,
   "text": "The navigation migration is merged, so that's done.\nDay-30 retention dropped from 41 to 36 percent after the August update.\nAction: Sam to send the retention cohort analysis by 2026-09-25.\nThanks, that will shape the onboarding work.",
   "token_count": 59,
   "updated_at": "2026-09-15T14:00:00+00:00"
  },
  {
   "created_at": "2026-09-01T10:00:00+00:00",
   "id": "f369e50c-d14d-50db-aed6-63a9b37a5739",
   "owner_id": "fixture-owner",
   "revision_id": "4fa4cbc3-62f3-5d93-8f1e-75e28d6cbf98",
   "segment_end": 5,
   "segment_start": 0,
   "seq": 0,
   "text": "Let's lock the plan for the 4.0 release.\nDecision: the 4.0 release ships on 2026-10-14.\nCrash-free sessions are at 97.2 percent; we need 99 before release.\nI'll migrate the app to the new navigation library in two weeks.\nIf legal blocks the tracking prompt, I'll drop the analytics SDK entirely.\nMei is carrying both the navigation work and the on-call rotation.",
   "token_count": 91,
   "updated_at": "2026-09-01T10:00:00+00:00"
  },
  {
   "created_at": "2026-09-08T10:00:00+00:00",
   "id": "20bf5182-32e2-51b2-9d3c-abc9c2bbb1b4",
   "owner_id": "fixture-owner",
   "revision_id": "64c12223-4de9-5e03-802b-2ae6709ede33",
   "segment_end": 3,
   "segment_start": 0,
   "seq": 0,
   "text": "Quick round today, mostly checkout.\nI'll write the regression plan for checkout by 2026-09-18.\nI'm not going to own the release notes this time.\nThe payment SDK update could break checkout on older Android phones.",
   "token_count": 54,
   "updated_at": "2026-09-08T10:00:00+00:00"
  },
  {
   "created_at": "2026-10-07T08:00:00+00:00",
   "id": "d2d9c4f0-495d-586c-8a5d-b4c72d663f96",
   "owner_id": "fixture-owner",
   "revision_id": "b336e7f5-9c58-5365-877b-b57bdd610b45",
   "segment_end": 3,
   "segment_start": 0,
   "seq": 0,
   "text": "The Android checkout bug is still open.\nI'll pair with Jonas on the Android checkout bug tomorrow.\nDo we need a feature flag for the new onboarding flow?\nI'll rewrite the onboarding copy if the experiment loses.",
   "token_count": 53,
   "updated_at": "2026-10-07T08:00:00+00:00"
  },
  {
   "created_at": "2026-10-13T10:00:00+00:00",
   "id": "fd71f5f9-706c-57f6-b62e-8617ce41bff9",
   "owner_id": "fixture-owner",
   "revision_id": "d37f7bc7-4c78-5425-9831-5829fa8eaaa1",
   "segment_end": 3,
   "segment_start": 0,
   "seq": 0,
   "text": "The regression plan for checkout went out on the 17th, and the full regression suite passed this morning.\nI sent the cohort analysis on the 24th.\nDecision: we keep the analytics SDK and ship the tracking prompt.\nI will send the release announcement to support on 2026-10-20.",
   "token_count": 69,
   "updated_at": "2026-10-13T10:00:00+00:00"
  },
  {
   "created_at": "2026-09-22T10:00:00+00:00",
   "id": "c7c4fbac-50bc-53f3-9670-cff2105e467a",
   "owner_id": "fixture-owner",
   "revision_id": "efeed64e-606b-549f-936b-6125694b4dca",
   "segment_end": 2,
   "segment_start": 0,
   "seq": 0,
   "text": "The payment SDK fix landed but it needs another week of QA.\nDecision: we move the 4.0 release to 2026-10-21 because the payment SDK fix needs another week of QA.\nAction: Jonas to rerun the full regression suite by 2026-10-16.",
   "token_count": 57,
   "updated_at": "2026-09-22T10:00:00+00:00"
  },
  {
   "created_at": "2026-10-27T11:00:00+00:00",
   "id": "9a9a7812-dd82-5c7e-874a-cd72c5c4a184",
   "owner_id": "fixture-owner",
   "revision_id": "f2b62552-21af-5d6a-ae76-7149dabc5621",
   "segment_end": 2,
   "segment_start": 0,
   "seq": 0,
   "text": "The 4.0 release went out on 2026-10-21 with 99.3 percent crash-free sessions.\nI sent the release announcement to support last Tuesday.\nI will not take on the tablet layout until the new year.",
   "token_count": 48,
   "updated_at": "2026-10-27T11:00:00+00:00"
  }
 ],
