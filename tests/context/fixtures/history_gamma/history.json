 "chunks": [
  {
   "created_at": "2026-08-13T15:00:00+00:00",
   "id": "4df71aca-39e1-52d7-b615-83edcc9e8f3a",
   "owner_id": "fixture-owner",
   "revision_id": "30a51cc4-d715-531b-ad00-e1e1055dbd8a",
   "segment_end": 3,
   "segment_start": 0,
   "seq": 0,
   "text": "We can do 52 dollars per seat on a two-year term.\nDecision: we accept a two-year term at 52 dollars per seat, because the price drop outweighs the lock-in.\nI'll draft the revised order form by 2026-08-07.\nI'll throw in premium support if procurement closes this week.",
   "token_count": 67,
   "updated_at": "2026-08-13T15:00:00+00:00"
  },
  {
   "created_at": "2026-07-14T21:00:00+00:00",
   "id": "acac9933-e413-548f-916c-cf34f3cb0e77",
   "owner_id": "fixture-owner",
   "revision_id": "625d8a92-6b26-55af-a290-bd1005ac2458",
   "segment_end": 4,
   "segment_start": 0,
   "seq": 0,
   "text": "I asked finance to join so we can settle the term question.\nA three-year term locks us in while our volumes are still uncertain.\nDecision: we only accept a one-year term with a renewal cap.\nI'll model the three-year cost by 2026-07-20 anyway, so we have the numbers.\nI won't sign anything until legal has reviewed the data processing addendum.",
   "token_count": 86,
   "updated_at": "2026-07-14T21:00:00+00:00"
  },
  {
   "created_at": "2026-08-11T23:00:00+00:00",
   "id": "4b014777-62c3-5e71-a2ca-3dd33b70f95f",
   "owner_id": "fixture-owner",
   "revision_id": "b402c940-260a-5967-b11f-460b7f72722b",
   "segment_end": 2,
   "segment_start": 0,
   "seq": 0,
   "text": "Legal finished the addendum review; two clauses need changes.\nAction: Nadia to send our redlines to Quillmark by 2026-08-14.\nDoes the two-year term include price protection on renewal?",
   "token_count": 46,
   "updated_at": "2026-08-11T23:00:00+00:00"
  },
  {
   "created_at": "2026-08-25T17:30:00+00:00",
   "id": "ce260bf5-0d74-50f4-a651-f08dc4ff9a66",
   "owner_id": "fixture-owner",
   "revision_id": "d2c4b220-6591-5dd2-83b2-d5d95ca867be",
   "segment_end": 4,
   "segment_start": 0,
   "seq": 0,
   "text": "The revised order form went out on the 6th.\nNadia sent our redlines on the 13th and Quillmark accepted them.\nDecision: Ashgrove signs the two-year order form on 2026-08-31.\nI'll send the countersigned contract within a day of receiving yours.\nI'm not committing to the analytics add-on this year.",
   "token_count": 74,
   "updated_at": "2026-08-25T17:30:00+00:00"
  },
  {
   "created_at": "2026-07-07T17:00:00+00:00",
   "id": "00778df9-5373-599a-a60c-f494ec832e77",
   "owner_id": "fixture-owner",
   "revision_id": "dd657111-ee4a-5d6d-ba7c-e04219b4a140",
   "segment_end": 5,
   "segment_start": 0,
   "seq": 0,
   "text": "List price is 64 dollars per seat per month, and you mentioned 120 seats.\nI'll send the security questionnaire answers in two weeks.\nIf you sign before the end of the quarter, we could waive the onboarding fee.\nWe'll need to see the security answers before we go further.\nJordan pushed hard on a three-year term.\nI'll check with finance whether a three-year term is acceptable.",
   "token_count": 95,
   "updated_at": "2026-07-07T17:00:00+00:00"
  },
  {
   "created_at": "2026-07-21T18:00:00+00:00",
   "id": "c154425d-94b2-551d-81f7-25a0b1ca86c9",
   "owner_id": "fixture-owner",
   "revision_id": "eeef250d-78d7-5779-8a79-6e12b271941f",
   "segment_end": 2,
   "segment_start": 0,
   "seq": 0,
   "text": "I sent the questionnaire answers on Friday.\nQuillmark stores backups in a single region, which worries me.\nAction: Nadia to get legal review of the data processing addendum by 2026-07-31.",
   "token_count": 47,
   "updated_at": "2026-07-21T18:00:00+00:00"
  }
 ],
